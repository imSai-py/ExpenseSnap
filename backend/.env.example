# ExpenseSnap Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_URL=postgresql://user:password@localhost:5432/expensesnap_db

# =============================================================================
# Security
# =============================================================================
# Generate a secure key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# =============================================================================
# Google OAuth (optional)
# =============================================================================
GCLOUD_CLIENT_ID=your-google-client-id
GCLOUD_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# Push Notifications (VAPID Keys)
# =============================================================================
# Generate keys by running: python run_notifications.py generate-vapid
# Or use: pip install py-vapid && vapid --gen --applicationServerKey
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_CONTACT_EMAIL=admin@expensesnap.com

# =============================================================================
# Notification Settings
# =============================================================================
# Hour to send daily reminders (0-23, default: 20 = 8 PM)
DAILY_REMINDER_HOUR=20

# Budget alert threshold (0.0-1.0, default: 0.8 = 80% of income)
BUDGET_ALERT_THRESHOLD=0.8

# =============================================================================
# Flask Environment
# =============================================================================
FLASK_ENV=development
